{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "@lotta-schule/hubert",
  "version": "7.0.0",
  "description": "Component Library for lotta",
  "author": "Alexis Rinaldoni <alexis.rinaldoni@einsa.net>",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "vitest --coverage",
    "lint": "oxlint --fix src/",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@epic-web/invariant": "^1.0.0",
    "@floating-ui/react": "^0.27.20",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.7.1",
    "lodash": "^4.18.1",
    "react-aria": "^3.53.1",
    "react-dropzone": "^20.1.4",
    "react-stately": "^3.51.0",
    "react-use": "^17.6.1"
  },
  "peerDependencies": {
    "framer-motion": ">=14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2"
  },
  "lint-staged": {
    "$schema": "https://json.schemastore.org/lint-staged",
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{graphql,gql}": [
      "prettier --write"
    ],
    "*.{html,xml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12"
  }
}
