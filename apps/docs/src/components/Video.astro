---
/**
 * Embeds a short screen recording generated by the e2e docs capture, e.g.
 *   <Video name="article-create" title="Einen Artikel anlegen" />
 * Files live in src/assets/videos/<name>.webm (generated, do not edit by hand).
 */
interface Props {
  name: string;
  title: string;
}

const { name, title } = Astro.props;

const videos = import.meta.glob<string>('../assets/videos/*.webm', {
  eager: true,
  query: '?url',
  import: 'default',
});
const src = videos[`../assets/videos/${name}.webm`];

if (!src) {
  console.warn(`[docs] Video "${name}" not found in src/assets/videos/`);
}
---

<figure class="lotta-video">
  {
    src ? (
      <video src={src} title={title} controls muted loop playsinline preload="metadata" />
    ) : (
      <div class="lotta-video-missing">Video „{name}“ fehlt noch</div>
    )
  }
  <figcaption>{title}</figcaption>
</figure>

<style>
  .lotta-video video {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .lotta-video figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }
  .lotta-video-missing {
    padding: 2rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.5rem;
    text-align: center;
    color: var(--sl-color-gray-3);
  }
</style>
