---
/**
 * Embeds a screenshot generated by the e2e docs capture
 * (apps/e2e, `docs` Playwright project) by its stable name, e.g.
 *   <Screenshot name="article-edit" alt="Artikel bearbeiten" />
 * Files live in src/assets/screenshots/<name>.png (generated, do not edit by hand).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screenshots/*.png',
  { eager: true }
);
const image = images[`../assets/screenshots/${name}.png`]?.default;

if (!image) {
  console.warn(`[docs] Screenshot "${name}" not found in src/assets/screenshots/`);
}
---

<figure class="lotta-screenshot">
  {
    image ? (
      <Image src={image} alt={alt} />
    ) : (
      <div class="lotta-screenshot-missing">Bild „{name}“ fehlt noch</div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .lotta-screenshot img {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .lotta-screenshot figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }
  .lotta-screenshot-missing {
    padding: 2rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.5rem;
    text-align: center;
    color: var(--sl-color-gray-3);
  }
</style>
