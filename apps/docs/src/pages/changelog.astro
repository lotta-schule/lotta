---
/**
 * Renders the repository's CHANGELOG.md (written by `nx release changelog`
 * in scripts/release.sh), so the docs always show the current release history.
 * Not a content-collection entry on purpose: it is generated, not edited.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Content } from '../../../../CHANGELOG.md';
---

<StarlightPage
  frontmatter={{
    title: 'Änderungen',
    description: 'Alle Änderungen an Lotta, Version für Version.',
    tableOfContents: { minHeadingLevel: 1, maxHeadingLevel: 2 },
  }}
>
  <Content />
</StarlightPage>
