{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@lotta-schule/lotta",
  "description": "Lotta Web Monorepo",
  "homepage": "https://lotta.schule",
  "scripts": {
    "dev": "nx run-many --target=dev --parallel --exclude core-api",
    "dev:full": "nx run-many --target=dev --parallel",
    "test": "nx run-many --target=test --parallel",
    "lint": "nx run-many --target=lint --parallel",
    "typecheck": "nx run-many --target=typecheck --parallel",
    "release:prepare": "./scripts/release.sh",
    "nx": "nx",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@nx/js": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@react-types/checkbox": "^3.11.0",
    "@react-types/progress": "^3.6.0",
    "@react-types/shared": "^3.37.0",
    "@rollup/plugin-graphql": "^3.0.0",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.18",
    "@swc/helpers": "~0.5.23",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/absinthe__socket": "^0.2.6",
    "@types/absinthe__socket-apollo-link": "^0.2.1",
    "@types/cookies": "^0.9.2",
    "@types/file-saver": "^2.0.7",
    "@types/is-url": "^1.2.32",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "@types/slate-base64-serializer": "^0.2.5",
    "@types/user-event": "^4.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "chromium-bidi": "^158.0.8110-0",
    "concurrently": "^10.0.6",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "graphql-tag": "^2.12.7",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lerna": "^10.1.1",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "lint-staged": {
    "$schema": "https://json.schemastore.org/lint-staged",
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.{graphql,gql}": [
      "prettier --write"
    ],
    "*.{html,xml}": [
      "prettier --write"
    ],
    "*.{ex,exs,eex,heex}": [
      "mix format"
    ]
  },
  "overrides": {
    "react-is": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
